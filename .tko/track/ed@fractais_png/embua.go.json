            "label": "2026-04-13_12-57-26",
            "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"math/rand\"\n)\n\nfunc randInt(min, max int) int {\n\treturn min + rand.Intn(max-min+1)\n}\n\nfunc embua(pen *Pen, coisa float64){\n\tif coisa < 10{\n\t\treturn\n\t}\n\tpen.SetRGB(255, 150, 255)\n\tpen.SetLineWidth(coisa/30)\n\tpen.Walk(coisa)\n\t//pen.SavePNG(\"tree.png\")\n\t//var dummy rune\n\t//fmt.Scanf(\"%c\", &dummy)\n\tpen.Right(90)\n\tcoisa *= 0.97\n\tembua(pen, coisa)\n\tpen.SetRGB(20, 20, 20)\n\tpen.Right(-90)\n\tpen.Walk(-coisa)\n}\n\nfunc main() {\n\tpen := NewPen(500, 500)   // cria um canvas de 500 de largura por 500 de altura\n     // muda a cor do pincel para vermelho\n\tpen.SetHeading(0)\n\tpen.SetPosition(100, 100)\n\t\n\tcoisa := 300.0\n\tembua(pen, coisa)\n\t\n\tpen.SavePNG(\"tree.png\")\n\tfmt.Println(\"PNG file created successfully.\")\n}\n",
