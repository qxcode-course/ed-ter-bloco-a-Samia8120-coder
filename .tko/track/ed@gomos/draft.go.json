            "content": "package main\n\nimport \"fmt\"\n\n/*\n\tfunc posicao(x int, y int, d string) {\n\t\tif d == \"L\" {\n\t\t\tx--\n\t\t\tfmt.Print(x, y, \"\\n\")\n\t\t} else if d == \"R\" {\n\t\t\tx++\n\t\t\tfmt.Print(x, y, \"\\n\")\n\t\t} else if d == \"U\" {\n\t\t\ty--\n\t\t\tfmt.Print(x, y, \"\\n\")\n\t\t} else if d == \"D\" {\n\t\t\ty++\n\t\t\tfmt.Print(x, y, \"\\n\")\n\t\t}\n\t}\n*/\nfunc main() {\n\tvar Q int\n\tvar D string\n\n\tfmt.Scan(&Q)\n\tfmt.Scan(&D)\n\n\tvetor_x := make([]int, Q)\n\tvetor_y := make([]int, Q)\n\n\tfor i := 0; i < Q; i++ {\n\t\tfmt.Scan(&vetor_x[i], &vetor_y[i])\n\t}\n\n\t//Logica\n\n\tif D == \"L\" {\n\t\tfor i := 0; i < Q; i++ {\n\t\t\tif i == 0 {\n\t\t\t\tfmt.Print(vetor_x[i]-1, vetor_y[i], \"\\n\")\n\t\t\t} else {\n\t\t\t\tfmt.Print(vetor_x[i-1], vetor_y[i-1], \"\\n\")\n\t\t\t}\n\t\t}\n\t}\n\tif D == \"R\" {\n\t\tfor i := 0; i < Q; i++ {\n\t\t\tif i == 0 {\n\t\t\t\tfmt.Print(vetor_x[i]+1, vetor_y[i], \"\\n\")\n\t\t\t} else {\n\t\t\t\tfmt.Print(vetor_x[i-1], vetor_y[i-1], \"\\n\")\n\t\t\t}\n\t\t}\n\t}\n\tif D == \"U\" {\n\t\tfor i := 0; i < Q; i++ {\n\t\t\tif i == 0 {\n\t\t\t\tfmt.Print(vetor_x[i], vetor_y[i]-1, \"\\n\")\n\t\t\t} else {\n\t\t\t\tfmt.Print(vetor_x[i-1], vetor_y[i-1], \"\\n\")\n\t\t\t}\n\t\t}\n\t}\n\tif D == \"D\" {\n\t\tfor i := 0; i < Q; i++ {\n\t\t\tif i == 0 {\n\t\t\t\tfmt.Print(vetor_x[i], vetor_y[i]+1, \"\\n\")\n\t\t\t} else {\n\t\t\t\tfmt.Print(vetor_x[i-1], vetor_y[i-1], \"\\n\")\n\t\t\t}\n\t\t}\n\t}\n}\n",
